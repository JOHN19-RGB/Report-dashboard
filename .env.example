GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
CLICKUP_API_TOKEN=your_clickup_personal_token
CLICKUP_WORKSPACE_ID=3868153
CLICKUP_B2C_MASTER_LIST_ID=
# Optional local-development proxy used only when local ClickUp credentials are absent.
CLICKUP_LOCAL_PROXY_URL=https://b2c-team-report-dashboard.vercel.app

# Customer file edits (Supabase). Server-only: never expose the secret key to the browser.
# Project URL: Supabase dashboard -> Project Settings -> Data API. Secret key: Project Settings -> API Keys -> Secret keys.
# The Vercel <-> Supabase integration sets NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY, which also work.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Team passcode required to add/edit/delete Customer file sites. On Vercel, editing stays off until this is set.
CUSTOMER_FILE_EDIT_PASSCODE=
